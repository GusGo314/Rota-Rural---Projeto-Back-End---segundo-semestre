@model RotaRural.ViewModels.Conta.CadastroViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Criar conta";
}

<div class="form-wrap">
    <h1>Rota Rural</h1>
    <p class="sub">Crie sua conta para vender ou comprar direto do produtor.</p>

    <nav class="auth-tabs" aria-label="Autenticação">
        <a class="auth-tab" asp-action="Login">Entrar</a>
        <a class="auth-tab ativo" asp-action="Cadastro">Criar conta</a>
    </nav>

    <fieldset class="perfis">
        <legend>Tipo de conta</legend>
        <label class="perfil">
            <input type="radio" asp-for="Perfil" value="Produtor" id="perfil-produtor" form="form-cadastro" />
            <span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C8 8 6 11 6 14a6 6 0 0 0 12 0c0-3-2-6-6-11Z"/></svg>
                Produtor
            </span>
        </label>
        <label class="perfil">
            <input type="radio" asp-for="Perfil" value="Comprador" id="perfil-comprador" form="form-cadastro" />
            <span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/><path d="M9 12a3 3 0 0 0 6 0"/></svg>
                Comprador
            </span>
        </label>
    </fieldset>

    <form id="form-cadastro" asp-action="Cadastro" method="post" novalidate data-perfil="@Model.Perfil">
        <div asp-validation-summary="ModelOnly" class="nota erro"></div>

        <div class="campo">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" class="txt" placeholder="Seu nome completo" autocomplete="name" />
            <span asp-validation-for="Nome" class="ajuda erro"></span>
        </div>

        <div class="campo meio cpf">
            <label asp-for="Cpf"></label>
            <input asp-for="Cpf" class="txt" inputmode="numeric" placeholder="000.000.000-00" maxlength="14" autocomplete="off" />
            <span asp-validation-for="Cpf" class="ajuda erro"></span>
        </div>

        <div class="campo meio" data-perfis="produtor">
            <label asp-for="NomeUnidadeFamiliar"></label>
            <input asp-for="NomeUnidadeFamiliar" class="txt" placeholder="Ex.: Sítio Boa Semente" />
            <span asp-validation-for="NomeUnidadeFamiliar" class="ajuda erro"></span>
        </div>

        <div class="campo" data-perfis="produtor">
            <label asp-for="Endereco"></label>
            <input asp-for="Endereco" class="txt" placeholder="Rua/Avenida/Estrada + Número" autocomplete="street-address" />
          
            <span class="ajuda">Usado para associar sua microrregião automaticamente.</span>
            <span asp-validation-for="Endereco" class="ajuda erro"></span>
        </div>
        <div class="campo">
            <label asp-for="MicrorregiaoId"> </label>
            <select asp-for="MicrorregiaoId" asp-items="Model.Municipios" class="txt">
                <option value="">Selecione o Municipio </option>
            </select>

        </div>

        <div class="campo meio" data-perfis="produtor">
            <label asp-for="Caf"></label>
            <input asp-for="Caf" class="txt" placeholder="CAF-MG-00000" />
            <span asp-validation-for="Caf" class="ajuda erro"></span>
        </div>

        <div class="campo meio" data-perfis="produtor">
            <label asp-for="Ima">Registro IMA <small>(opcional)</small></label>
            <input asp-for="Ima" class="txt" placeholder="Só para processados" />
            <span asp-validation-for="Ima" class="ajuda erro"></span>
        </div>

        <div class="campo">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="txt" placeholder="joao@rotarural.com.br" autocomplete="email" />
            <span asp-validation-for="Email" class="ajuda erro"></span>
        </div>

        <div class="campo">
            <label asp-for="Senha"></label>
            <input asp-for="Senha" class="txt" placeholder="Mínimo 8 caracteres" autocomplete="new-password" />
            <span asp-validation-for="Senha" class="ajuda erro"></span>
        </div>

        <div class="campo">
            <label asp-for="ConfirmarSenha"></label>
            <input asp-for="ConfirmarSenha" class="txt" placeholder="Repita a senha" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarSenha" class="ajuda erro"></span>
        </div>

        <button type="submit" class="btn primeiro" id="btn-criar">Criar conta</button>
    </form>
</div>
