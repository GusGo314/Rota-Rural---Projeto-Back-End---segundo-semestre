@{
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();

    string Classe(string controller) =>
        controllerAtual == controller ? "menu-item ativo" : "menu-item";

    string? Atual(string controller) =>
        controllerAtual == controller ? "page" : null;
}

<nav class="menu" aria-label="Painel do produtor">
    <a asp-controller="Perfil" asp-action="Index"
       class="@Classe("Perfil")" aria-current="@Atual("Perfil")">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
        </svg>
        Meu perfil
    </a>

    <a asp-controller="Produtos" asp-action="Index"
       class="@Classe("Produtos")" aria-current="@Atual("Produtos")">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="20" r="1.5" />
            <circle cx="18" cy="20" r="1.5" />
            <path d="M2 3h3l2.5 12h12l2-8H6.2" />
        </svg>
        Meus produtos
    </a>

    <a asp-controller="Pedidos" asp-action="Index"
       class="@Classe("Pedidos")" aria-current="@Atual("Pedidos")">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 7h14l-1 14H6L5 7z" />
            <path d="M9 10a3 3 0 0 0 6 0" />
        </svg>
        Pedidos recebidos
    </a>

    <a asp-controller="Mensagens" asp-action="Index"
       class="@Classe("Mensagens")" aria-current="@Atual("Mensagens")">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16v12H8l-4 4V4z" />
        </svg>
        Mensagens
    </a>
</nav>